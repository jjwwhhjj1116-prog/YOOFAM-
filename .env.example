# TTS+영상 변환기 — 필요한 API 키 (실제 값은 .env 에, 저장소에 올리지 말 것)

# 나레이션(주인님 목소리 클론) + 대사 옵션
ELEVENLABS_API_KEY=sk_...

# 대사 기본 엔진
TYPECAST_API_KEY=...

# 대사 옵션 — Gemini TTS (google-genai>=2.29.0 필요)
#   aistudio.google.com/apikey · 무료 티어는 하루 10여 건에서 429가 난다
GEMINI_API_KEY=...

# 2026-08-31 서비스 종료. 코드 경로만 남아 있고 실제로는 사용 불가.
SUPERTONE_API_KEY=...
